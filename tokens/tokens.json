{
  "name": "Ч",
  "description": "Галерея искусства и слушания. Один человек, один час, один объект.",
  "version": "3.3.0",

  "color": {
    "wall":  { "value": "#FFFFFF", "type": "color", "role": "фон, тишина, пустая половина" },
    "ink":   { "value": "#000000", "type": "color", "role": "знак и текст" },
    "ochre": { "value": "#A78353", "type": "color", "role": "акцент, не более 1% площади" },

    "dark": {
      "wall":  { "value": "#101010", "type": "color" },
      "ink":   { "value": "#F2F0EC", "type": "color" },
      "ochre": { "value": "#C9A16A", "type": "color" }
    }
  },

  "ratio": {
    "wall": 90,
    "ink": 9,
    "ochre": 1,
    "note": "обязательная пропорция площадей на любом носителе"
  },

  "contrast": {
    "ink-on-wall":  { "value": "21:1",  "use": "везде" },
    "wall-on-ink":  { "value": "21:1",  "use": "инверсия, вывеска, тёмная тема" },
    "ink-on-ochre": { "value": "5.5:1", "use": "текст от 14px, кнопки" },
    "ochre-on-wall":{ "value": "3.5:1", "use": "крупный набор от 24px, линии, заливки. Основной текст — нет" }
  },

  "type": {
    "family": "Helvetica Neue",
    "fallback": ["Helvetica", "Nimbus Sans", "Arial"],
    "weights": { "ultralight": 100, "light": 300, "regular": 400, "medium": 500 },
    "forbidden": ["bold", "black", "condensed", "italic"],
    "numerals": "tabular-nums",
    "measure": "63 знака",
    "labelTracking": "0.18em",
    "note": "моноширинного начертания в семействе нет и не требуется — цифры табличные по построению"
  },

  "mark": {
    "field": "2u × 1u",
    "line": "0.7u × u/10",
    "lineCap": "butt",
    "dot": "0.3u",
    "gap": "0.5u",
    "clearspace": "0.5u",
    "minPx": 32,
    "minMm": 10,
    "versions": ["horizontal", "vertical"],
    "note": "площадь черты равна площади точки: 0.7 × 0.1 = 0.070u², π(0.15u)² = 0.0707u²"
  },

  "grid": {
    "module": "u",
    "emptyHalfMin": 0.5,
    "dotsPerSurface": 1,
    "formats": ["2:1", "1:2"]
  },

  "motion": {
    "transition": "600ms linear",
    "properties": ["opacity"],
    "note": "никаких сдвигов, масштабирования и пружин; звука интерфейса нет"
  }
}
