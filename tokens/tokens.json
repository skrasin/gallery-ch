{
  "name": "кабинет медленного искусства",
  "short": "h",
  "case": "lowercase",
  "description": "Убежище для светского уединения. Одна комната, одно произведение, один час.",
  "version": "4.0.0",

  "color": {
    "wall":  { "value": "#FFFFFF", "type": "color", "role": "стена, тишина, пустая половина" },
    "ink":   { "value": "#000000", "type": "color", "role": "знак и текст" },
    "ochre": { "value": "#A78353", "type": "color", "role": "дерево павильона, не более 1% площади" },

    "dark": {
      "wall":  { "value": "#101010", "type": "color" },
      "ink":   { "value": "#F2F0EC", "type": "color" },
      "ochre": { "value": "#C9A16A", "type": "color" }
    }
  },

  "ratio": {
    "wall": 90,
    "ink": 9,
    "ochre": 1,
    "note": "обязательная пропорция площадей на любом носителе"
  },

  "contrast": {
    "ink-on-wall":   { "value": "21:1",  "use": "везде" },
    "wall-on-ink":   { "value": "21:1",  "use": "инверсия, вывеска, тёмная тема" },
    "ink-on-ochre":  { "value": "5.5:1", "use": "текст от 14px, кнопки" },
    "ochre-on-wall": { "value": "3.5:1", "use": "крупный набор от 24px, линии, заливки. Основной текст — нет" }
  },

  "type": {
    "family": "Helvetica Neue",
    "fallback": ["Helvetica", "Nimbus Sans", "Arial"],
    "weights": { "ultralight": 100, "light": 300, "regular": 400, "medium": 500 },
    "forbidden": ["bold", "black", "condensed", "italic"],
    "numerals": "tabular-nums",
    "measure": "63 знака",
    "labelTracking": "0.18em",
    "note": "имя набирается строчными в любом кегле, даже в начале предложения"
  },

  "mark": {
    "field": "2u × 1u",
    "height": "0.7u",
    "bracket": "u/20",
    "arm": "0.12u",
    "line": "u/10",
    "dot": "0.3u",
    "gap": "0.5u",
    "axis": "1u",
    "clearspace": "0.5u",
    "lineCap": "butt",
    "minPx": 40,
    "minMm": 12,
    "versions": ["full", "full-vertical", "reduced", "reduced-vertical"],
    "notes": [
      "черта на оси симметрии поля, точка в центре правой половины, левая половина пуста",
      "редуцированный знак — полный минус скобки, поле и все величины те же",
      "скобки вдвое тоньше черты: оболочка легче содержания",
      "площадь черты равна площади точки: 0.7 × 0.1 = 0.070u², π(0.15u)² = 0.0707u²"
    ]
  },

  "grid": {
    "module": "u",
    "emptyHalfMin": 0.5,
    "dotsPerSurface": 1,
    "formats": ["2:1", "1:2"],
    "distanceRule": "между чертой и точкой не встаёт ничего"
  },

  "motion": {
    "transition": "600ms linear",
    "properties": ["opacity"],
    "note": "никаких сдвигов, масштабирования и пружин; звука интерфейса нет"
  }
}
